# Local development only. Choose your own password before starting PostgreSQL.
POSTGRES_USER=lee
POSTGRES_PASSWORD=
POSTGRES_DB=lee_pos
POSTGRES_PORT=5432
# Set this using the same credentials; URL-encode special characters in the password.
DATABASE_URL=
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Browser values are public. Never put secrets in a VITE_ variable.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Run npm run env:init to generate these locally. Never commit the generated values.
JWT_SECRET=
BRANCH_ID=00000000-0000-4000-8000-000000000001
ADMIN_PASSWORD=
CASHIER_PASSWORD=
